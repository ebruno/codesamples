#!/usr/bin/env zsh
# Generate docs/index.html (GitHub) or pages/index.html (GitLab)
# Usage: generate_docs_index.zsh <github|gitlab>

set -euo pipefail

MODE="${1:-}"
if [[ "$MODE" != "github" && "$MODE" != "gitlab" ]]; then
    echo "Usage: $0 <github|gitlab>" >&2
    exit 1
fi

# Determine script directory and codesamples root
SCRIPT_DIR="${0:a:h}"
CODESAMPLES_DIR="${SCRIPT_DIR:A:h:h}"

if [[ "$MODE" == "github" ]]; then
    MODE_DIR="docs"
    INDEX="${CODESAMPLES_DIR}/docs/index.html"
    TITLE="Codesamples GitHub Pages"
    COLOR="#0366d6"
else
    MODE_DIR="pages"
    INDEX="${CODESAMPLES_DIR}/pages/index.html"
    TITLE="Codesamples GitLab Pages"
    COLOR="#e24329"
fi

# Function to extract project description from README.md
get_project_desc() {
    local subdir="$1"
    local readme="${CODESAMPLES_DIR}/${subdir}/README.md"
    
    if [[ -f "$readme" ]]; then
        # Read first line and strip leading # characters using native zsh
        local desc
        read -r desc < "$readme" || true
        if [[ -n "$desc" ]]; then
            # Strip leading # and spaces using native zsh parameter expansion
            desc="${desc##\#\# }"
            desc="${desc#\# }"
            echo "$desc"
            return
        fi
    fi
    
    # Fallback
    echo "Documentation for ${subdir}"
}

# Function to check if directory should be skipped
is_skip_dir() {
    local dir_name="$1"
    case "$dir_name" in
        utils|docs|pages) return 0 ;;
        *) return 1 ;;
    esac
}

# Function to generate index HTML
generate_index() {
    # Ensure parent directory exists
    mkdir -p "$(dirname "${INDEX}")"
    
    # Collect project cards
    local cards=""
    local found=0
    
    for subdir in ${CODESAMPLES_DIR}/*/; do
        # Get directory name without trailing slash
        local dir_name="${subdir:t}"
        
        # Skip excluded directories
        if is_skip_dir "$dir_name"; then
            continue
        fi
        
        # Check for index.html in this subdirectory under the correct mode directory
        local project_index="${CODESAMPLES_DIR}/${MODE_DIR}/${dir_name}/index.html"
        if [[ -f "$project_index" ]]; then
            found=1
            local desc
            desc=$(get_project_desc "$dir_name")
            
            cards="${cards}
    <div class=\"project-card\">
        <h2>${dir_name}</h2>
        <a href=\"${dir_name}/index.html\" style=\"color: ${COLOR};\">View Documentation →</a>
    </div>"
        fi
    done
    
    # If no docs found, generate a placeholder
    if [[ $found -eq 0 ]]; then
        cards="
    <div class=\"project-card\">
        <h2>No Documentation Available</h2>
        <p>Run <code>make publish-to-${MODE}</code> to generate documentation first.</p>
    </div>"
    fi
    
    # Write the index page
    cat > "${INDEX}" << EOF
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>${TITLE}</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; max-width: 800px; margin: 40px auto; padding: 0 20px; color: #333; }
        h1 { border-bottom: 2px solid ${COLOR}; padding-bottom: 10px; }
        .project-card { border: 1px solid #e1e4e8; border-radius: 6px; padding: 20px; margin: 16px 0; }
        .project-card h2 { margin-top: 0; color: #333; }
        .project-card a { display: inline-block; background-color: #0366d6; color: #ffffff !important; padding: 8px 16px; border-radius: 4px; text-decoration: none; font-weight: bold; }
        .project-card a:hover { background-color: #0256b9; }
    </style>
</head>
<body>
    <h1>${TITLE}</h1>

${cards}

    <hr>
    <p><small>Auto-generated by generate_docs_index.zsh</small></p>
</body>
</html>
EOF
    
    echo "Generated: ${INDEX}"
}

# Generate the index file for the specified mode
generate_index