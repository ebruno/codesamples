# Generated reports and logs (regenerated each run — never commit)
reports/
**/cpp/reports/
**/cpp/logs/
**/tests/reports/
**/tests/logs/
src/common/java/logs/
src/common/python/build.log
src/common/python/logs/

# Build output directories (produced by native builds on any platform)
**/cpp/build/

# Compiled test binaries (generated by test infrastructure builds)
**/tests/bin/test*

# IDE and OS noise
.DS_Store
*~
#*#
.cpp_build_failed
.dockerfile_created_by_step0
.ringbuffer_start
__pycache__/

# Java / Maven build artifacts
target/
*.class
*.jar
*.war
*.ear

# IDE files
.idea/
*.iml
.vscode/
.project
.classpath
.settings/

# Build artifacts (libraries, object files — regenerated each run)
**/lib/*.a
**/lib/*.so
**/lib/*.dylib
**/*.o

# Interactive session state (new_os_setup workflow)
.ringbuffer_sessions/
**/.gen_state.json

# Local SSH host config (user-provided, never commit)
config/ssh_hosts.json
