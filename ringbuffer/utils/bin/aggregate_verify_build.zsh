#!/usr/bin/env zsh
# aggregate_verify_build.zsh — Merge all per-OS build verification reports into a summary
# Usage: ./utils/bin/aggregate_verify_build.zsh [workspace_root]
# Scans reports/<lang>/per_os/*_build_verify.md and produces:
#   reports/build_verify_summary.md

set -euo pipefail

WORKSPACE="${1:-.}"
REPORTS_DIR="$WORKSPACE/reports"
OUTPUT="$REPORTS_DIR/build_verify_summary.md"

echo "=== Aggregating build verification reports ==="
echo "Workspace: $WORKSPACE"

pass_count=0
fail_count=0
unsupported_count=0
declare -a rows

for lang_dir in "$REPORTS_DIR"/cpp "$REPORTS_DIR"/java "$REPORTS_DIR"/python; do
    [ -d "$lang_dir" ] || continue
    lang=$(basename "$lang_dir")
    per_os_dir="$lang_dir/per_os"
    [ -d "$per_os_dir" ] || continue

    for md_file in "$per_os_dir"/*_build_verify.md; do
        [ -f "$md_file" ] || continue
        bname=$(basename "$md_file")
        os_tag="${bname%%_build_verify.md}"

        # Determine build_status from file content
        if grep -q "UNSUPPORTED\|unsupported\|skipped" "$md_file" 2>/dev/null; then
            build_status="UNSUPPORTED"
            unsupported_count=$((unsupported_count + 1))
        elif grep -q "PASS\|Success\|passed" "$md_file" 2>/dev/null; then
            build_status="PASS"
            pass_count=$((pass_count + 1))
        else
            build_status="FAIL"
            fail_count=$((fail_count + 1))
        fi

        report_link="[Full report](${lang}/per_os/${os_tag}_build_verify.md)"
        rows+=("| $os_tag | $lang | $build_status | $report_link |")
    done
done

total=$((pass_count + fail_count + unsupported_count))

# Generate summary
{
    echo "# Build Verification Summary"
    echo ""
    echo "**Date:** $(date '+%Y-%m-%d %H:%M:%S %z')"
    echo ""
    echo "## Overview"
    echo ""
    echo "| | Count |"
    echo "| :--- | :--- |"
    echo "| PASS | $pass_count |"
    echo "| FAIL | $fail_count |"
    echo "| UNSUPPORTED | $unsupported_count |"
    echo "| **Total** | **$total** |"
    echo ""
    echo "## Per-OS Results"
    echo ""
    echo "| OS | Results |"
    echo "| :--- | :--- |"
    printf '%s\n' "${rows[@]}" | sort | (
        prev_os=""
        cell=""
        while IFS='|' read -r _ os_tag lang status link _; do
            os_tag="${os_tag# }"; os_tag="${os_tag% }"
            lang="${lang# }"; lang="${lang% }"
            status="${status# }"; status="${status% }"
            link="${link# }"; link="${link% }"
            entry="$lang — $status — $link"
            if [ "$os_tag" != "$prev_os" ]; then
                if [ -n "$prev_os" ]; then
                    echo "| $prev_os | $cell |"
                fi
                prev_os="$os_tag"
                cell="$entry"
            else
                cell="$cell<br>$entry"
            fi
        done
        if [ -n "$prev_os" ]; then
            echo "| $prev_os | $cell |"
        fi
    )
    echo ""
    echo "---"
    echo "*Generated by aggregate_verify_build.sh*"
} > "$OUTPUT"

echo "Aggregated $total build reports into $OUTPUT"
echo "  PASS: $pass_count  FAIL: $fail_count  UNSUPPORTED: $unsupported_count"
