# Doxygen configuration for swtr_ringbuffer C++ class diagrams

PROJECT_NAME           = "swtr_ringbuffer C++"
PROJECT_NUMBER         = 1.0.0-1
OUTPUT_DIRECTORY       = ../../../docs/ringbuffer/cpp/html
# Main page overview (Doxygen 1.17+ uses @mainpage in source)
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES

# Input — scan all C++ source directories (future-proof)
INPUT                  = ../../../src/common/cpp \
                         ../../../src/macos/cpp \
                         ../../../src/fedora/cpp \
                         ../../../src/debian/cpp \
                         ../../../src/ubuntu/cpp \
                         ../../../src/raspios/cpp \
                         ../../../src/archlinux/cpp \
                         swtr_ringbuffer_overview.md

# Only include C++ source, header, and markdown files
FILE_PATTERNS          = *.cpp *.hpp *.md

# Recurse into subdirectories (for src/*/cpp/)
RECURSIVE              = YES

# Exclude test files and build artifacts
EXCLUDE_PATTERNS       = */tests/* \
                         *.o \
                         *~

# Output — HTML only (standalone landing page)
GENERATE_HTML          = YES
HTML_OUTPUT            = .
HTML_FILE_EXTENSION    = .html
GENERATE_HTMLHELP      = NO
GENERATE_QHP           = NO

# Standalone landing page with brief descriptions
GENERATE_TREEVIEW      = YES
FULL_PATH_NAMES        = NO

# Diagrams — PNG format via Graphviz DOT tool
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = png
UML_LOOK               = YES
COLLABORATION_GRAPH    = YES
CLASS_GRAPH            = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES

# Document everything — public and private
EXTRACT_ALL            = YES

# Preprocessor defines for Doxygen (so it can expand macros)
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
PREDEFINED             = "SWTR_EXPORT=__attribute__((visibility(\"default\")))"
                         "__attribute__(x)="
SKIP_FUNCTION_MACROS   = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_PACKAGE        = NO

# Show undocumented relations in diagrams (not hide them)
HIDE_UNDOC_RELATIONS   = NO

# Limit diagram size to prevent huge graphs
DOT_GRAPH_MAX_NODES    = 50
MAX_DOT_GRAPH_DEPTH    = 1000

# UML-style formatting
UML_LIMIT_NUM_FIELDS   = 50
TEMPLATE_RELATIONS     = YES

# Brief descriptions in landing page
SHORT_NAMES            = NO
JAVADOC_AUTOBRIEF      = YES

# Alphabetical index
ALPHABETICAL_INDEX     = YES

# Ignore common system headers
IGNORE_PREFIX          = 

# Generate a standalone index.html with project overview
GENERATE_LATEX         = NO
