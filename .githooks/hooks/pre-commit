#!/usr/bin/env bash
# Sed works differently accross MacOS, Freebsd and Linux.
# Need to determine which OS the commit is happening on.
declare -i exit_status=0;
if [ -z "${GIT_HOOK_PRECOMMIT_TEST_MODE}" ]; then
    GIT_HOOK_PRECOMMIT_TEST_MODE=1;
fi;
if [ -f /etc/os-release ]; then
    . /etc/os-release;
else
    os_name="$(uname -s)";
    if [ "${os_name}" = "Darwin" ] && [ -e "/usr/bin/sw_vers" ]; then
	ID="$(sw_vers -productName)";
	MACOS_VERSION_FULL="$(sw_vers -productVersion)";
	VERSION_ID="${MACOS_VERSION_FULL%.*}";
    else
	echo "[ERROR] Unable to determine OS version for ${os_name}";
	exit_status=1;
    fi;
fi;

# Model info for prompts
MODEL_INFO="Llama-3.1-70B-Instruct (Q8_0), System Prompt v1.0"
TARGET_PATTERN="ringbuffer/prompts/(fedora|macos)/cpp/(functional|build|testing)\.md"

if [ ${exit_status} -eq 0 ]; then
   tmpfile="$(mktemp)";
   git diff --cached --name-only > "${tmpfile}";
   while read line
   do
       # YAML tab removal
       if [[ "${line}" =~ .yml$ ]] || [[ "${line}" =~ .yaml$ ]]; then
	  case ${ID} in
	      macOS|MacOS|freebsd)
		  sed -i ".bak" -e 's/\t/    /g' "${line}"
		  ;;
	      debian|rhel|fedora|ubuntu|arch)
		  sed -i.bak -e 's/\t/    /g' "${line}"
		  ;;
	      *)
		  echo "[WARNING] Unsupported ID=${ID}, skipping tab removal."
		  exit_status=1;
		  break;
		  ;;
	  esac;
	  if [ -f "${line}.bak" ]; then
	      rm -f "${line}.bak";
	  fi;
       fi;

       # Prompt header update
       if [[ "${line}" =~ $TARGET_PATTERN ]]; then
           TIMESTAMP=$(date "+%Y-%b-%d %H:%M:%S")
           HEADER="This file was generated on: ${TIMESTAMP} by ${MODEL_INFO}"
           
           if grep -q "^This file was generated on:" "${line}"; then
               case ${ID} in
                   macOS|MacOS|freebsd)
                       sed -i '' "1s/^This file was generated on:.*/${HEADER}/" "${line}"
                       ;;
                   debian|rhel|fedora|ubuntu|arch)
                       sed -i "1s/^This file was generated on:.*/${HEADER}/" "${line}"
                       ;;
                   *)
                       echo "[WARNING] Unsupported ID=${ID}, skipping header update."
                       ;;
               esac
           else
               echo "${HEADER}" | cat - "${line}" > "${line}.tmp" && mv "${line}.tmp" "${line}"
           fi
           git add "${line}"
       fi
   done < "${tmpfile}";
   rm -f "${tmpfile}";
fi;
if [ ${GIT_HOOK_PRECOMMIT_TEST_MODE} -eq 0 ]; then
    exit_status=1;
fi;
exit ${exit_status};
